{
  "permissions": {
    "allow": ["Read", "Edit", "Write", "Glob", "Grep", "Bash(*)"],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "/home/agent/.claude-config/hooks/pre.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "/home/agent/.claude-config/hooks/post.sh" }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "/home/agent/.claude-config/hooks/stop.sh" }] }
    ]
  }
}
